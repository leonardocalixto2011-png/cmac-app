# ── CMAC Beauty — copy to .env and fill in. Never commit .env. ───────────────
# This project has its OWN Stripe / Resend / Neon accounts. Never reuse keys
# from another project (e.g. the Couca & Co. app).

# Neon Postgres — pooled connection string for the app
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for `prisma migrate`. Vercel's Neon integration injects BOTH names automatically.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Local dev with `npx prisma dev` instead: paste its URL and append
#   ?sslmode=disable&pgbouncer=true&connection_limit=1

# Auth.js v5
AUTH_SECRET=""            # generate: npx auth secret
AUTH_URL="http://localhost:3000"

# Public site URL (used for Stripe redirect URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login — seeded by `npm run db:seed`
ADMIN_EMAIL="admin@cmacbeauty.ca"
ADMIN_PASSWORD="cmac-admin-dev"

# Stripe — CMAC Beauty's own account (test keys first, then live)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""  # from the /api/stripe/webhook endpoint you create in Stripe

# Resend — order confirmations, shipping notices, contact-form forwards
RESEND_API_KEY=""
EMAIL_FROM="CMAC Beauty <orders@cmacbeauty.ca>"

# Where new-order and contact-form notifications go (falls back to ADMIN_EMAIL)
OWNER_NOTIFY_EMAIL=""
