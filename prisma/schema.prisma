// CMAC Beauty — data model.
// Storefront products + orders, customer accounts + Glow Club loyalty ledger,
// newsletter subscribers (CASL double opt-in) + campaigns, contact messages,
// plus Auth.js models (admin + customer credentials login).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ----------------------------------------------------------------------------
// Catalogue
// ----------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameFr         String
  nameEn         String
  // Short one-liner under the title ("Hands-free glow, 10 minutes a night")
  tagline        String?
  taglineFr      String?
  // HTML: intro + <h3>How to use</h3> + <h3>Good to know</h3>
  descriptionFr  String?
  descriptionEn  String?
  priceCents     Int
  // "Was" price shown struck through when greater than priceCents
  compareAtCents Int?
  // Collection membership: "glow" | "sculpt" | "cool" (+ free-form tags, "new")
  tags           String[] @default([])
  images         Json     @default("[]") // string[] of image URLs
  // [{ mp4, poster }] — short muted supplier clips (Cloudinary), shown in the gallery
  videos         Json     @default("[]")
  // [{ nameFr, nameEn, values: [{ value, labelFr, labelEn }] }] — e.g. Colour
  options        Json     @default("[]")
  stock          Int? // null = not tracked
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  // Fulfilment (admin-only): supplier listing + SKU, internal note
  supplierUrl    String?
  supplierSku    String?
  shippingNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id                      String         @id @default(cuid())
  reference               String         @unique @default(cuid())
  status                  OrderStatus    @default(PENDING)
  contactEmail            String
  contactName             String?
  // [{ productId, slug, nameFr, nameEn, priceCents, qty, options: {name: label}, optionsEn: {...} }]
  items                   Json           @default("[]")
  subtotalCents           Int
  shippingCents           Int            @default(0)
  totalCents              Int
  shippingJson            Json? // Stripe-collected shipping address
  locale                  String         @default("en")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  // Fulfilment
  trackingNumber          String?
  trackingUrl             String?
  supplierOrderId         String?
  fulfilledAt             DateTime?
  // Stripe discounts applied at checkout (promo / reward codes). Merchandise = subtotal - discount.
  discountCents           Int            @default(0)
  // Cart checkbox "email me offers" (unchecked by default) → CASL double opt-in on payment
  newsletterOptIn         Boolean        @default(false)
  // Abandoned checkout: Stripe collected promotions consent + the session expired → one reminder
  recoveryEmailSentAt     DateTime?
  // Review request (~3 weeks after fulfilment): tokenised link to /review/<token>
  reviewToken             String?        @unique
  reviewRequestSentAt     DateTime?
  reviews                 Review[]
  customerId              String?
  customer                Customer?      @relation(fields: [customerId], references: [id])
  loyaltyEntries          LoyaltyEntry[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

// One per email. Created from paid orders (guest) or on sign-up. Glow Club member = has a userId.
model Customer {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String?
  locale             String         @default("en")
  // Login account (Auth.js User, role CUSTOMER). Null = guest buyer, not a Glow Club member.
  userId             String?        @unique
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  birthMonth         Int?
  birthDay           Int?
  // Year the birthday reward was last issued (cron idempotency)
  birthdayRewardYear Int?
  // "Don't ask me for reviews again" (link in the review request email)
  reviewEmailsOptOut Boolean        @default(false)
  // Cached sums of the LoyaltyEntry ledger (source of truth), updated in the same transaction
  points             Int            @default(0)
  lifetimeSpendCents Int            @default(0)
  orders             Order[]
  loyaltyEntries     LoyaltyEntry[]
  rewardCodes        RewardCode[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// ----------------------------------------------------------------------------
// Glow Club — points ledger + reward codes
// ----------------------------------------------------------------------------

enum LoyaltyReason {
  ORDER_CREDIT
  ORDER_REVERSAL
  REDEEM
  ADJUSTMENT
}

// Append-only ledger. (orderId, reason) unique → an order is credited / reversed at most once.
model LoyaltyEntry {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points     Int
  // Merchandise spend counted toward the tier (+ on credit, - on reversal)
  spendCents Int           @default(0)
  reason     LoyaltyReason
  note       String?
  createdAt  DateTime      @default(now())

  @@unique([orderId, reason])
  @@index([customerId, createdAt])
}

enum RewardKind {
  POINTS
  BIRTHDAY
}

// Single-use Stripe promotion codes issued to a member (points redemption or birthday).
model RewardCode {
  id                    String     @id @default(cuid())
  customerId            String
  customer              Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind                  RewardKind
  code                  String     @unique
  stripePromotionCodeId String     @unique
  amountOffCents        Int?
  percentOff            Int?
  pointsSpent           Int        @default(0)
  expiresAt             DateTime?
  redeemedAt            DateTime?
  createdAt             DateTime   @default(now())

  @@index([customerId])
}

// ----------------------------------------------------------------------------
// Reviews — only from real orders (verified buyer), published after admin approval
// ----------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug  String
  rating       Int // 1–5
  title        String?
  body         String
  // Display name as the customer chose it ("Camille B.")
  authorName   String
  locale       String       @default("en")
  status       ReviewStatus @default(PENDING)
  // Received as a gift / free product (creator seeding) — must be disclosed on the page
  incentivized Boolean      @default(false)
  createdAt    DateTime     @default(now())
  approvedAt   DateTime?

  @@unique([orderId, productSlug])
  @@index([productSlug, status])
}

// ----------------------------------------------------------------------------
// Newsletter + contact form
// ----------------------------------------------------------------------------

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// CASL: double opt-in. Consent is recorded (when, where, exact wording) and every
// marketing email carries a one-click unsubscribe token.
model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  locale           String           @default("en")
  status           SubscriberStatus @default(PENDING)
  consentAt        DateTime?
  // footer | popup | register | checkout | account
  consentSource    String?
  consentText      String?
  confirmToken     String?          @unique
  unsubscribeToken String           @unique @default(cuid())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@index([status])
}

model Campaign {
  id           String    @id @default(cuid())
  subjectEn    String
  subjectFr    String
  preheaderEn  String?
  preheaderFr  String?
  bodyEn       String
  bodyFr       String
  productSlugs String[]  @default([])
  // SENDING | SENT | PARTIAL | FAILED
  status       String    @default("SENDING")
  recipients   Int       @default(0)
  sentCount    Int       @default(0)
  failedCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
}

// Fixed-window counters for login / register / reset / signup throttling.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Auth.js (v5) — Prisma adapter models (admin credentials login)
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String? // bcrypt; ADMIN (seeded) and CUSTOMER (sign-up) credentials login
  customer      Customer?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
